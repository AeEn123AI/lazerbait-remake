; Engine configuration file.
; Lazerbait (Godot remake)

config_version=5

[application]

config/name="Lazerbait"
config/description="A Godot Engine remake of Lazerbait, the VR real-time strategy game. Supports desktop and VR (OpenXR) with optional passthrough."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Settings="*res://scripts/core/settings.gd"
Stats="*res://scripts/core/stats.gd"
GameTime="*res://scripts/core/game_time.gd"
XRManager="*res://scripts/core/xr_manager.gd"
Debug="*res://scripts/core/debug.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/vsync/vsync_mode=1

[editor_plugins]

enabled=PackedStringArray()

[input_devices]

pointing/emulate_touch_from_mouse=false

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0
lights_and_shadows/directional_shadow/size=4096
environment/defaults/default_clear_color=Color(0.0749, 0.0772, 0.0809, 1)

[xr]

openxr/enabled=true
openxr/default_action_map="res://openxr_action_map.tres"
openxr/foveation_level=0
openxr/reference_space=1
openxr/environment_blend_mode=0
openxr/startup_alert=false
shaders/enabled=true
openxr/extensions/render_model=true
openxr/extensions/meta/passthrough=true
openxr/extensions/htc/passthrough=true
